generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHARMACIST
  TECHNICIAN
  INTERN
  CASHIER
  AUDITOR
}

enum PrescriptionStatus {
  RECEIVED
  DATA_ENTRY
  DUR_REVIEW
  PRODUCT_FILL
  PHARMACIST_REVIEW
  READY
  SOLD
  ON_HOLD
  CANCELLED
  TRANSFERRED
}

enum FillStatus {
  SCHEDULED
  IN_PROGRESS
  READY
  SOLD
  RETURNED_TO_STOCK
  CANCELLED
}

enum FillKind {
  STANDARD
  PARTIAL
  COMPLETION
  EMERGENCY_SUPPLY
}

enum DurSeverity {
  INFO
  WARNING
  HIGH
}

enum DurIssueStatus {
  OPEN
  RESOLVED
}

enum PrescriberIdentifierType {
  NPI
  DEA
  STATE_ID
}

enum PrescriberContactType {
  PHONE
  FAX
}

enum ProductUnit {
  EACH
  GRAM
  MILLILITER
}

enum ProductBarcodeType {
  GTIN_14
  UPC_A
  EAN_13
  OTHER
}

enum InventoryTransactionType {
  RECEIVE
  RESERVE
  RELEASE
  DISPENSE
  RETURN_TO_STOCK
  ADJUSTMENT
  QUARANTINE
  RELEASE_QUARANTINE
  DISPOSE
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_CANCEL_RETURN
}

enum InventoryHoldStatus {
  ACTIVE
  RELEASED
  DISPOSED
}

enum InventoryHoldReason {
  DAMAGED
  EXPIRED
  RECALL
  SUSPECT_PRODUCT
  TEMPERATURE_EXCURSION
  OTHER
}

enum InventoryDispositionType {
  DESTROY
  RETURN_TO_VENDOR
  REVERSE_DISTRIBUTOR
  OTHER
}

enum CycleCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

enum InventoryTransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum RecallStatus {
  ACTIVE
  CLOSED
}

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryLocationType {
  DISPENSING
  RECEIVING
  REFRIGERATOR
  FREEZER
  SAFE
  QUARANTINE
  RETURN_TO_VENDOR
  OVERFLOW
  UNASSIGNED
  OTHER
}

enum InventoryDemandReason {
  PARTIAL_COMPLETION
  SCHEDULED_FILL
  SHORTAGE
  MANUAL
}

enum InventoryDemandStatus {
  OPEN
  PARTIALLY_SATISFIED
  SATISFIED
  CANCELLED
}

enum ReceivingDiscrepancyType {
  SHORT_SHIPMENT
  OVERAGE
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  LOT_EXPIRATION_MISMATCH
  INVOICE_MISMATCH
  DUPLICATE_SHIPMENT
  UNPLANNED_RECEIPT
  OTHER
}

enum ReceivingDiscrepancyStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TransferCustodyEventType {
  PACKED
  VERIFIED
  HANDED_OFF
  RECEIVED
  DISCREPANCY_REPORTED
  CANCELLED
}

model PharmacySite {
  id            String         @id @default(uuid())
  name          String
  npi           String?
  ncpdpId       String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  patients      Patient[]
  prescribers   Prescriber[]
  prescriptions Prescription[]
  productLots           ProductLot[]
  productExpirations    ProductExpiration[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  cycleCountSessions    CycleCountSession[]
  inventoryHolds        InventoryHold[]
  sourceInventoryTransfers      InventoryTransfer[] @relation("TransferSourceSite")
  destinationInventoryTransfers InventoryTransfer[] @relation("TransferDestinationSite")
  recallCases           RecallCase[]
  purchaseOrders        PurchaseOrder[]
  inventoryLocations    InventoryLocation[]
  inventoryPolicies     InventoryPolicy[]
  inventoryDemands      InventoryDemand[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  inventoryOperationKeys InventoryOperationKey[]
  inventoryCostLayers   InventoryCostLayer[]
  auditEvents           AuditEvent[]
}

model User {
  id                String             @id @default(uuid())
  siteId            String
  site              PharmacySite       @relation(fields: [siteId], references: [id])
  externalAuthId    String?            @unique
  displayName       String
  role              UserRole
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditEvents       AuditEvent[]       @relation("ActorAuditEvents")
  resolvedDurIssues DurIssue[]         @relation("ResolvedDurIssues")
  interventionNotes     InterventionNote[]     @relation("InterventionAuthors")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionActors")
  createdCycleCounts     CycleCountSession[]     @relation("CycleCountCreatedBy")
  submittedCycleCounts   CycleCountSession[]     @relation("CycleCountSubmittedBy")
  reviewedCycleCounts    CycleCountSession[]     @relation("CycleCountReviewedBy")
  countedCycleCountLines CycleCountLine[]        @relation("CycleCountCountedBy")
  createdInventoryHolds  InventoryHold[]          @relation("InventoryHoldCreatedBy")
  resolvedInventoryHolds InventoryHold[]          @relation("InventoryHoldResolvedBy")
  initiatedTransfers     InventoryTransfer[]        @relation("TransferInitiatedBy")
  receivedTransfers      InventoryTransfer[]        @relation("TransferReceivedBy")
  cancelledTransfers     InventoryTransfer[]        @relation("TransferCancelledBy")
  createdRecallCases     RecallCase[]               @relation("RecallCreatedBy")
  closedRecallCases      RecallCase[]               @relation("RecallClosedBy")
  createdPurchaseOrders  PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  cancelledPurchaseOrders PurchaseOrder[]           @relation("PurchaseOrderCancelledBy")
  purchaseOrderReceipts  PurchaseOrderReceipt[]     @relation("PurchaseOrderReceiptActor")
  authorizedEmergencyFills PrescriptionFill[]         @relation("EmergencyFillAuthorizedBy")
  inventoryLocationMovements InventoryLocationMovement[] @relation("InventoryLocationMovementActor")
  createdReceivingDiscrepancies ReceivingDiscrepancy[]   @relation("ReceivingDiscrepancyCreatedBy")
  resolvedReceivingDiscrepancies ReceivingDiscrepancy[]  @relation("ReceivingDiscrepancyResolvedBy")
  transferCustodyEvents InventoryTransferCustodyEvent[]   @relation("TransferCustodyEventActor")

  @@index([siteId, role])
}

model Patient {
  id            String         @id @default(uuid())
  siteId        String
  site          PharmacySite   @relation(fields: [siteId], references: [id])
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  phone         String?
  phoneSearch   String?
  email         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]

  @@index([siteId, lastName, firstName])
  @@index([siteId, dateOfBirth])
  @@index([siteId, phoneSearch])
}

model Prescriber {
  id                String                 @id @default(uuid())
  siteId            String
  site              PharmacySite           @relation(fields: [siteId], references: [id])
  firstName         String
  lastName          String
  practiceLevel     String
  dateOfBirth       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  prescriptions     Prescription[]
  identifiers       PrescriberIdentifier[]
  contacts          PrescriberContact[]
  addresses         PrescriberAddress[]

  @@index([siteId, lastName, firstName])
  @@index([siteId, dateOfBirth])
  @@index([siteId, practiceLevel])
}

model PrescriberIdentifier {
  id             String                   @id @default(uuid())
  siteId         String
  prescriberId   String
  prescriber     Prescriber               @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  type           PrescriberIdentifierType
  number         String
  numberSearch   String
  jurisdiction   String                   @default("")
  isPrimary      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([prescriberId, type, numberSearch, jurisdiction])
  @@index([siteId, type, numberSearch])
  @@index([prescriberId, type, isPrimary])
}

model PrescriberContact {
  id             String                 @id @default(uuid())
  prescriberId   String
  prescriber     Prescriber             @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  type           PrescriberContactType
  label          String?
  value          String
  valueSearch    String
  extension      String?
  isPrimary      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([prescriberId, type, isPrimary])
  @@index([type, valueSearch])
}

model PrescriberAddress {
  id             String     @id @default(uuid())
  prescriberId   String
  prescriber     Prescriber @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  label          String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  isPrimary      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([prescriberId, isPrimary])
  @@index([state, postalCode])
}

model Medication {
  id            String    @id @default(uuid())
  genericName   String
  brandName     String?
  strength      String
  dosageForm    String
  route         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
  prescriptions Prescription[]
  inventoryDemands InventoryDemand[]
  inventoryPolicies InventoryPolicy[]

  @@index([genericName, strength, dosageForm])
  @@index([brandName])
}

model Manufacturer {
  id          String    @id @default(uuid())
  name        String    @unique
  labelerCode String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
}

model Product {
  id                 String       @id @default(uuid())
  medicationId       String
  medication         Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  manufacturerId     String
  manufacturer       Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  ndc                 String
  ndcSearch           String       @unique
  descriptor          String
  packageDescription  String?
  packageType         String?
  unitsPerPackage     Decimal?     @db.Decimal(12, 3)
  dispensingUnit      ProductUnit?
  unitPrice           Decimal?     @db.Decimal(12, 6)
  packagePrice        Decimal?     @db.Decimal(12, 4)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lots                ProductLot[]
  expirations         ProductExpiration[]
  prescriptionFills   PrescriptionFill[]
  barcodes             ProductBarcode[]
  inventoryBalances    InventoryBalance[]
  recallCases           RecallCase[]
  purchaseOrderLines    PurchaseOrderLine[]
  inventoryPolicies      InventoryPolicy[]
  inventoryCostLayers    InventoryCostLayer[]

  @@index([medicationId, active])
  @@index([manufacturerId, active])
  @@index([ndc])
  @@index([descriptor])
}

model ProductBarcode {
  id               String             @id @default(uuid())
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             ProductBarcodeType
  identifier       String
  identifierSearch String
  isPrimary        Boolean            @default(false)
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([type, identifierSearch])
  @@index([productId, isPrimary])
  @@index([identifierSearch])
}

model ProductLot {
  id              String       @id @default(uuid())
  siteId          String
  site            PharmacySite @relation(fields: [siteId], references: [id])
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotNumber       String
  lotNumberSearch String
  active          Boolean      @default(true)
  receivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([siteId, productId, lotNumberSearch])
  @@index([productId, lotNumberSearch])
  prescriptionFills  PrescriptionFill[]
  inventoryBalances   InventoryBalance[]

  @@index([siteId, active])
}

model ProductExpiration {
  id             String       @id @default(uuid())
  siteId         String
  site           PharmacySite @relation(fields: [siteId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  expirationDate DateTime
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([siteId, productId, expirationDate])
  @@index([siteId, expirationDate])
  prescriptionFills PrescriptionFill[]
  inventoryBalances  InventoryBalance[]

  @@index([productId, expirationDate])
}

model Prescription {
  id                       String              @id @default(uuid())
  siteId                   String
  site                     PharmacySite        @relation(fields: [siteId], references: [id])
  patientId                String
  patient                  Patient             @relation(fields: [patientId], references: [id])
  prescriberId             String
  prescriber               Prescriber          @relation(fields: [prescriberId], references: [id])
  medicationId             String?
  medication               Medication?         @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  rxNumber                 String?
  medicationName           String
  strength                 String?
  dosageForm               String?
  sig                      String
  quantityWritten          Decimal?            @db.Decimal(10, 3)
  refillsAllowed           Int                 @default(0)
  refillsUsed              Int                 @default(0)
  writtenDate              DateTime?
  expirationDate           DateTime?
  minimumDaysBetweenFills  Int?
  status                   PrescriptionStatus  @default(RECEIVED)
  heldFromStatus           PrescriptionStatus?
  doNotFillBefore          DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  fills                    PrescriptionFill[]
  durIssues                DurIssue[]
  interventionNotes        InterventionNote[]

  @@unique([siteId, rxNumber])
  @@index([siteId, status])
  @@index([patientId])
  @@index([medicationId])
}

model PrescriptionFill {
  id                  String             @id @default(uuid())
  prescriptionId      String
  prescription        Prescription       @relation(fields: [prescriptionId], references: [id])
  fillNumber          Int
  partNumber          Int                @default(1)
  kind                FillKind           @default(STANDARD)
  scheduledFor        DateTime?
  quantity            Decimal?           @db.Decimal(10, 3)
  authorizedQuantity  Decimal?           @db.Decimal(10, 3)
  consumesRefill      Boolean            @default(true)
  completionOfFillId  String?
  completionOfFill    PrescriptionFill?  @relation("FillCompletionChain", fields: [completionOfFillId], references: [id], onDelete: Restrict)
  completionFills     PrescriptionFill[] @relation("FillCompletionChain")
  emergencyReason     String?
  emergencyAuthorizedById String?
  emergencyAuthorizedBy User?            @relation("EmergencyFillAuthorizedBy", fields: [emergencyAuthorizedById], references: [id], onDelete: Restrict)
  emergencyAuthorizedAt DateTime?
  followUpDueAt       DateTime?
  followUpCompletedAt DateTime?
  followUpNote        String?
  status              FillStatus         @default(SCHEDULED)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productLotId        String?
  productLot          ProductLot?        @relation(fields: [productLotId], references: [id], onDelete: Restrict)
  productExpirationId String?
  productExpiration   ProductExpiration? @relation(fields: [productExpirationId], references: [id], onDelete: Restrict)
  scannedNdc          String?
  scannedLotNumber    String?
  scannedExpiration   DateTime?
  productVerifiedAt   DateTime?
  inventoryBalanceId  String?
  inventoryBalance    InventoryBalance? @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  inventoryReservedAt DateTime?
  inventoryCommittedAt DateTime?
  inventoryReturnedAt DateTime?
  inventoryTransactions InventoryTransaction[]
  recallAffectedFills RecallAffectedFill[]
  inventoryDemand     InventoryDemand?
  inventoryCostConsumptions InventoryCostConsumption[]
  filledAt            DateTime?
  soldAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([prescriptionId, fillNumber, partNumber])
  @@index([completionOfFillId])
  @@index([kind, status, scheduledFor])
  @@index([followUpDueAt, followUpCompletedAt])
  @@index([scheduledFor, status])
  @@index([productId])
  @@index([productLotId])
  @@index([productExpirationId])
  @@index([inventoryBalanceId])
}

model InventoryBalance {
  id                  String             @id @default(uuid())
  siteId              String
  site                PharmacySite       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  productLotId        String
  productLot          ProductLot         @relation(fields: [productLotId], references: [id], onDelete: Restrict)
  productExpirationId String
  productExpiration   ProductExpiration  @relation(fields: [productExpirationId], references: [id], onDelete: Restrict)
  onHandQuantity      Decimal            @default(0) @db.Decimal(14, 3)
  reservedQuantity    Decimal            @default(0) @db.Decimal(14, 3)
  quarantinedQuantity Decimal            @default(0) @db.Decimal(14, 3)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  fills               PrescriptionFill[]
  transactions        InventoryTransaction[]
  cycleCountLines      CycleCountLine[]
  holds                InventoryHold[]
  sourceTransfers       InventoryTransfer[] @relation("TransferSourceBalance")
  destinationTransfers  InventoryTransfer[] @relation("TransferDestinationBalance")
  purchaseOrderReceipts PurchaseOrderReceipt[]
  positions             InventoryPosition[]
  inventoryCostLayers   InventoryCostLayer[]
  inventoryCostConsumptions InventoryCostConsumption[]

  @@unique([siteId, productId, productLotId, productExpirationId])
  @@index([siteId, productId])
  @@index([productLotId])
  @@index([productExpirationId])
}

model CycleCountSession {
  id            String           @id @default(uuid())
  siteId        String
  site          PharmacySite     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  status        CycleCountStatus @default(OPEN)
  createdById   String
  createdBy     User             @relation("CycleCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedById String?
  submittedBy   User?            @relation("CycleCountSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    User?            @relation("CycleCountReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  note          String?
  reviewNote    String?
  createdAt     DateTime         @default(now())
  submittedAt   DateTime?
  reviewedAt    DateTime?
  lines         CycleCountLine[]

  @@index([siteId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([submittedById, submittedAt])
  @@index([reviewedById, reviewedAt])
}

model CycleCountLine {
  id                    String            @id @default(uuid())
  cycleCountSessionId   String
  cycleCountSession     CycleCountSession @relation(fields: [cycleCountSessionId], references: [id], onDelete: Cascade)
  inventoryBalanceId    String
  inventoryBalance      InventoryBalance  @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  expectedOnHand        Decimal?          @db.Decimal(14, 3)
  expectedReserved      Decimal?          @db.Decimal(14, 3)
  expectedQuarantined   Decimal?          @db.Decimal(14, 3)
  countedQuantity       Decimal?          @db.Decimal(14, 3)
  discrepancy           Decimal?          @db.Decimal(14, 3)
  countedById           String?
  countedBy             User?             @relation("CycleCountCountedBy", fields: [countedById], references: [id], onDelete: Restrict)
  countedAt             DateTime?
  reconciledTransactionId String?             @unique
  reconciledTransaction   InventoryTransaction? @relation("CycleCountReconciliation", fields: [reconciledTransactionId], references: [id], onDelete: Restrict)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([cycleCountSessionId, inventoryBalanceId])
  @@index([inventoryBalanceId, createdAt])
  @@index([countedById, countedAt])
}

model InventoryHold {
  id                 String                   @id @default(uuid())
  siteId             String
  site               PharmacySite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  inventoryBalanceId String
  inventoryBalance   InventoryBalance         @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  quantity           Decimal                  @db.Decimal(14, 3)
  reasonCode         InventoryHoldReason
  note               String?
  status             InventoryHoldStatus      @default(ACTIVE)
  createdById        String
  createdBy          User                     @relation("InventoryHoldCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedById       String?
  resolvedBy         User?                    @relation("InventoryHoldResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolutionNote     String?
  dispositionType    InventoryDispositionType?
  createdAt          DateTime                 @default(now())
  resolvedAt         DateTime?
  updatedAt          DateTime                 @updatedAt
  transactions       InventoryTransaction[]
  recallCaseId        String?
  recallCase          RecallCase?               @relation(fields: [recallCaseId], references: [id], onDelete: Restrict)

  @@index([siteId, status, createdAt])
  @@index([inventoryBalanceId, status])
  @@index([reasonCode, status])
  @@index([createdById, createdAt])
  @@index([resolvedById, resolvedAt])
  @@index([recallCaseId, status])
}

model InventoryTransaction {
  id                 String                   @id @default(uuid())
  siteId             String
  site               PharmacySite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  inventoryBalanceId String
  inventoryBalance   InventoryBalance         @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  fillId             String?
  fill               PrescriptionFill?        @relation(fields: [fillId], references: [id], onDelete: Restrict)
  actorId            String?
  actor              User?                    @relation("InventoryTransactionActors", fields: [actorId], references: [id], onDelete: Restrict)
  type               InventoryTransactionType
  onHandDelta        Decimal                  @default(0) @db.Decimal(14, 3)
  reservedDelta      Decimal                  @default(0) @db.Decimal(14, 3)
  quarantinedDelta   Decimal                  @default(0) @db.Decimal(14, 3)
  inventoryHoldId    String?
  inventoryHold      InventoryHold?           @relation(fields: [inventoryHoldId], references: [id], onDelete: Restrict)
  reason             String?
  source             String?
  reference          String?
  occurredAt         DateTime                 @default(now())
  cycleCountLine     CycleCountLine?          @relation("CycleCountReconciliation")
  inventoryTransferId String?
  inventoryTransfer   InventoryTransfer?       @relation(fields: [inventoryTransferId], references: [id], onDelete: Restrict)
  purchaseOrderReceipt PurchaseOrderReceipt?   @relation("PurchaseOrderReceiptTransaction")
  inventoryCostLayer   InventoryCostLayer?

  @@index([siteId, occurredAt])
  @@index([inventoryBalanceId, occurredAt])
  @@index([fillId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([inventoryHoldId, occurredAt])
  @@index([inventoryTransferId, occurredAt])
}

model InventoryTransfer {
  id                       String                  @id @default(uuid())
  sourceSiteId             String
  sourceSite               PharmacySite            @relation("TransferSourceSite", fields: [sourceSiteId], references: [id], onDelete: Restrict)
  destinationSiteId        String
  destinationSite          PharmacySite            @relation("TransferDestinationSite", fields: [destinationSiteId], references: [id], onDelete: Restrict)
  sourceInventoryBalanceId String
  sourceInventoryBalance   InventoryBalance        @relation("TransferSourceBalance", fields: [sourceInventoryBalanceId], references: [id], onDelete: Restrict)
  destinationInventoryBalanceId String?
  destinationInventoryBalance   InventoryBalance?   @relation("TransferDestinationBalance", fields: [destinationInventoryBalanceId], references: [id], onDelete: Restrict)
  productId                String
  lotNumber                String
  expirationDate           DateTime
  quantity                 Decimal                 @db.Decimal(14, 3)
  status                   InventoryTransferStatus @default(IN_TRANSIT)
  note                     String?
  initiatedById            String
  initiatedBy              User                    @relation("TransferInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  receivedById             String?
  receivedBy               User?                   @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledById            String?
  cancelledBy              User?                   @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  shippedAt                DateTime                 @default(now())
  receivedAt               DateTime?
  cancelledAt              DateTime?
  transactions             InventoryTransaction[]
  custodyEvents            InventoryTransferCustodyEvent[]

  @@index([sourceSiteId, status, shippedAt])
  @@index([destinationSiteId, status, shippedAt])
  @@index([sourceInventoryBalanceId, status])
}

model RecallCase {
  id               String       @id @default(uuid())
  siteId           String
  site             PharmacySite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotNumber        String?
  lotNumberSearch  String?
  reference        String
  reason           String
  status           RecallStatus @default(ACTIVE)
  createdById      String
  createdBy        User         @relation("RecallCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedById       String?
  closedBy         User?        @relation("RecallClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  closedAt         DateTime?
  closureNote      String?
  holds            InventoryHold[]
  affectedFills    RecallAffectedFill[]

  @@index([siteId, status, createdAt])
  @@index([siteId, productId, lotNumberSearch, status])
  @@index([reference])
}

model RecallAffectedFill {
  id           String           @id @default(uuid())
  recallCaseId String
  recallCase   RecallCase       @relation(fields: [recallCaseId], references: [id], onDelete: Cascade)
  fillId       String
  fill         PrescriptionFill @relation(fields: [fillId], references: [id], onDelete: Restrict)
  discoveredAt DateTime         @default(now())

  @@unique([recallCaseId, fillId])
  @@index([fillId])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  siteId        String
  site          PharmacySite        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orderNumber   String
  supplierName  String
  status        PurchaseOrderStatus @default(OPEN)
  note          String?
  createdById   String
  createdBy     User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledById String?
  cancelledBy   User?               @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())
  cancelledAt   DateTime?
  lines         PurchaseOrderLine[]

  @@unique([siteId, orderNumber])
  @@index([siteId, status, createdAt])
  @@index([supplierName])
}

model PurchaseOrderLine {
  id                 String        @id @default(uuid())
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOrdered    Decimal       @db.Decimal(14, 3)
  quantityReceived   Decimal       @default(0) @db.Decimal(14, 3)
  unitCost           Decimal?      @db.Decimal(12, 6)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  receipts           PurchaseOrderReceipt[]
  demandLinks        InventoryDemandSupplyLink[]
  discrepancies      ReceivingDiscrepancy[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseOrderReceipt {
  id                     String               @id @default(uuid())
  purchaseOrderLineId    String
  purchaseOrderLine      PurchaseOrderLine    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  actorId                String
  actor                  User                 @relation("PurchaseOrderReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  inventoryBalanceId     String
  inventoryBalance       InventoryBalance     @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  inventoryTransactionId String                @unique
  inventoryTransaction   InventoryTransaction @relation("PurchaseOrderReceiptTransaction", fields: [inventoryTransactionId], references: [id], onDelete: Restrict)
  quantity               Decimal              @db.Decimal(14, 3)
  lotNumber              String
  expirationDate         DateTime
  invoiceReference       String?
  receivedAt             DateTime             @default(now())
  discrepancies          ReceivingDiscrepancy[]

  @@index([purchaseOrderLineId, receivedAt])
  @@index([inventoryBalanceId, receivedAt])
}


model InventoryLocation {
  id            String                @id @default(uuid())
  siteId        String
  site          PharmacySite          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  code          String
  name          String
  type          InventoryLocationType @default(OTHER)
  active        Boolean               @default(true)
  temperatureMinC Decimal?            @db.Decimal(6, 2)
  temperatureMaxC Decimal?            @db.Decimal(6, 2)
  pickPriority  Int                   @default(100)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  positions     InventoryPosition[]
  movementsFrom InventoryLocationMovement[] @relation("InventoryLocationMovementFrom")
  movementsTo   InventoryLocationMovement[] @relation("InventoryLocationMovementTo")

  @@unique([siteId, code])
  @@index([siteId, type, active])
  @@index([siteId, pickPriority])
}

model InventoryPosition {
  id                 String            @id @default(uuid())
  inventoryBalanceId String
  inventoryBalance   InventoryBalance  @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  locationId         String
  location           InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity           Decimal           @default(0) @db.Decimal(14, 3)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  movementsFrom      InventoryLocationMovement[] @relation("InventoryLocationMovementPositionFrom")
  movementsTo        InventoryLocationMovement[] @relation("InventoryLocationMovementPositionTo")

  @@unique([inventoryBalanceId, locationId])
  @@index([locationId])
}

model InventoryLocationMovement {
  id              String             @id @default(uuid())
  siteId          String
  inventoryBalanceId String
  inventoryBalance InventoryBalance  @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  fromLocationId  String?
  fromLocation    InventoryLocation? @relation("InventoryLocationMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId    String?
  toLocation      InventoryLocation? @relation("InventoryLocationMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  fromPositionId  String?
  fromPosition    InventoryPosition? @relation("InventoryLocationMovementPositionFrom", fields: [fromPositionId], references: [id], onDelete: Restrict)
  toPositionId    String?
  toPosition      InventoryPosition? @relation("InventoryLocationMovementPositionTo", fields: [toPositionId], references: [id], onDelete: Restrict)
  quantity        Decimal            @db.Decimal(14, 3)
  actorId         String
  actor           User               @relation("InventoryLocationMovementActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason          String?
  occurredAt      DateTime           @default(now())

  @@index([siteId, occurredAt])
  @@index([inventoryBalanceId, occurredAt])
}

model InventoryPolicy {
  id                        String       @id @default(uuid())
  siteId                    String
  site                      PharmacySite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  policyKey                 String
  medicationId              String?
  medication                Medication?  @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  productId                 String?
  product                   Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  reorderPoint              Decimal?     @db.Decimal(14, 3)
  parLevel                  Decimal?     @db.Decimal(14, 3)
  minShelfLifeDays          Int?
  expirationWarningDays     Int          @default(90)
  fefoEnabled               Boolean      @default(true)
  preferredSupplierName     String?
  adjustmentApprovalThreshold Decimal?   @db.Decimal(14, 3)
  requireTransferSecondCheck Boolean     @default(false)
  staleReservationHours     Int          @default(24)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([siteId, policyKey])
  @@index([siteId, medicationId])
  @@index([siteId, productId])
}

model InventoryDemand {
  id                 String                @id @default(uuid())
  siteId             String
  site               PharmacySite          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  medicationId       String
  medication         Medication            @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  preferredProductId String?
  fillId             String?               @unique
  fill               PrescriptionFill?     @relation(fields: [fillId], references: [id], onDelete: Restrict)
  reason             InventoryDemandReason
  status             InventoryDemandStatus @default(OPEN)
  quantityRequired   Decimal               @db.Decimal(14, 3)
  quantitySatisfied  Decimal               @default(0) @db.Decimal(14, 3)
  dueAt              DateTime?
  note               String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  supplyLinks        InventoryDemandSupplyLink[]

  @@index([siteId, status, dueAt])
  @@index([siteId, medicationId, status])
}

model InventoryDemandSupplyLink {
  id                  String             @id @default(uuid())
  inventoryDemandId   String
  inventoryDemand     InventoryDemand    @relation(fields: [inventoryDemandId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  quantityPlanned     Decimal            @db.Decimal(14, 3)
  quantityReceived    Decimal            @default(0) @db.Decimal(14, 3)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([inventoryDemandId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
}

model ReceivingDiscrepancy {
  id                  String                     @id @default(uuid())
  siteId              String
  site                PharmacySite               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine?         @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  purchaseOrderReceiptId String?
  purchaseOrderReceipt PurchaseOrderReceipt?     @relation(fields: [purchaseOrderReceiptId], references: [id], onDelete: Restrict)
  type                ReceivingDiscrepancyType
  status              ReceivingDiscrepancyStatus @default(OPEN)
  expectedQuantity    Decimal?                   @db.Decimal(14, 3)
  observedQuantity    Decimal?                   @db.Decimal(14, 3)
  detail              String
  createdById         String
  createdBy           User                       @relation("ReceivingDiscrepancyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedById        String?
  resolvedBy          User?                      @relation("ReceivingDiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolutionNote      String?
  createdAt           DateTime                   @default(now())
  resolvedAt          DateTime?
  updatedAt           DateTime                   @updatedAt

  @@index([siteId, status, createdAt])
  @@index([purchaseOrderLineId, status])
  @@index([purchaseOrderReceiptId])
}

model InventoryOperationKey {
  id               String       @id @default(uuid())
  siteId           String
  site             PharmacySite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  operationType    String
  idempotencyKey   String
  resultEntityType String?
  resultEntityId   String?
  createdAt        DateTime     @default(now())

  @@unique([siteId, operationType, idempotencyKey])
  @@index([createdAt])
}

model InventoryTransferCustodyEvent {
  id                String                   @id @default(uuid())
  inventoryTransferId String
  inventoryTransfer InventoryTransfer        @relation(fields: [inventoryTransferId], references: [id], onDelete: Cascade)
  type              TransferCustodyEventType
  actorId           String
  actor             User                     @relation("TransferCustodyEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  carrier           String?
  trackingReference String?
  sealIdentifier    String?
  note              String?
  occurredAt        DateTime                 @default(now())

  @@index([inventoryTransferId, occurredAt])
}

model InventoryCostLayer {
  id                  String               @id @default(uuid())
  siteId              String
  site                PharmacySite         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  inventoryBalanceId  String
  inventoryBalance    InventoryBalance     @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  productId           String
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceTransactionId String                @unique
  sourceTransaction   InventoryTransaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Restrict)
  quantityReceived    Decimal              @db.Decimal(14, 3)
  quantityRemaining   Decimal              @db.Decimal(14, 3)
  unitCost            Decimal              @db.Decimal(12, 6)
  acquiredAt          DateTime             @default(now())
  sourceType          String
  reference           String?
  consumptions        InventoryCostConsumption[]

  @@index([siteId, productId, acquiredAt])
  @@index([inventoryBalanceId, acquiredAt])
}

model InventoryCostConsumption {
  id                 String             @id @default(uuid())
  inventoryCostLayerId String
  inventoryCostLayer InventoryCostLayer @relation(fields: [inventoryCostLayerId], references: [id], onDelete: Restrict)
  inventoryBalanceId String
  inventoryBalance   InventoryBalance   @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  fillId             String
  fill               PrescriptionFill   @relation(fields: [fillId], references: [id], onDelete: Restrict)
  quantity           Decimal           @db.Decimal(14, 3)
  unitCost           Decimal           @db.Decimal(12, 6)
  consumedAt         DateTime          @default(now())
  reversedAt         DateTime?

  @@index([fillId, consumedAt])
  @@index([inventoryCostLayerId, consumedAt])
}

model DurIssue {
  id             String         @id @default(uuid())
  prescriptionId String
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])
  code           String
  title          String
  description           String?
  severity              DurSeverity    @default(WARNING)
  status                DurIssueStatus @default(OPEN)
  source                String         @default("SYNTHETIC_RULE")
  eligibleAt            DateTime?
  createdAt             DateTime       @default(now())
  resolvedAt            DateTime?
  resolutionNote        String?
  resolvedAutomatically Boolean        @default(false)
  resolvedById          String?
  resolvedBy            User?          @relation("ResolvedDurIssues", fields: [resolvedById], references: [id])

  @@index([prescriptionId, status])
  @@index([code, status])
}

model InterventionNote {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  authorId       String
  author         User         @relation("InterventionAuthors", fields: [authorId], references: [id])
  note           String
  createdAt      DateTime     @default(now())

  @@index([prescriptionId, createdAt])
}

model AuditEvent {
  id         String       @id @default(uuid())
  siteId     String
  site       PharmacySite @relation(fields: [siteId], references: [id])
  actorId    String?
  actor      User?        @relation("ActorAuditEvents", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  requestId  String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  @@index([siteId, occurredAt])
  @@index([entityType, entityId])
}
