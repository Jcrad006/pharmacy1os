generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivilegedAccessKind {
  ROLE_GRANT
  TEMP_PERMISSION
}

enum PrivilegedAccessStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum UserRole {
  ADMIN
  PHARMACIST
  PHARMACIST_IN_CHARGE
  INVENTORY_MANAGER
  TECHNICIAN
  INTERN
  CASHIER
  AUDITOR
}

enum PrescriptionStatus {
  RECEIVED
  DATA_ENTRY
  DUR_REVIEW
  PRODUCT_FILL
  PHARMACIST_REVIEW
  READY
  SOLD
  ON_HOLD
  CANCELLED
  TRANSFERRED
}

enum FillStatus {
  SCHEDULED
  IN_PROGRESS
  READY
  SOLD
  RETURNED_TO_STOCK
  CANCELLED
}

enum FillKind {
  STANDARD
  PARTIAL
  COMPLETION
  EMERGENCY_SUPPLY
}

enum FillBillingRole {
  PRIMARY_CLAIM
  COMPLETION_OF_PRIMARY
  EMERGENCY_SUPPLY
}

enum FillInterruptionReason {
  INSUFFICIENT_PHYSICAL_STOCK
  DAMAGED_PRODUCT
  EXPIRED_PRODUCT
  STOCK_DISCREPANCY
  OTHER
}

enum DurSeverity {
  INFO
  WARNING
  HIGH
}

enum DurIssueStatus {
  OPEN
  RESOLVED
}

enum PrescriberIdentifierType {
  NPI
  DEA
  STATE_ID
}

enum PrescriberContactType {
  PHONE
  FAX
}

enum ProductUnit {
  EACH
  GRAM
  MILLILITER
}

enum ProductBarcodeType {
  GTIN_14
  UPC_A
  EAN_13
  OTHER
}

enum InventoryTransactionType {
  RECEIVE
  RESERVE
  RELEASE
  DISPENSE
  RETURN_TO_STOCK
  ADJUSTMENT
  QUARANTINE
  RELEASE_QUARANTINE
  DISPOSE
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_CANCEL_RETURN
  MOVE_LOCATION
}

enum InventoryHoldStatus {
  ACTIVE
  RELEASED
  DISPOSED
}

enum InventoryHoldReason {
  DAMAGED
  EXPIRED
  RECALL
  SUSPECT_PRODUCT
  TEMPERATURE_EXCURSION
  OTHER
}

enum InventoryDispositionType {
  DESTROY
  RETURN_TO_VENDOR
  REVERSE_DISTRIBUTOR
  OTHER
}

enum CycleCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

enum InventoryTransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum RecallStatus {
  ACTIVE
  CLOSED
}

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryLocationType {
  SHELF
  BIN
  REFRIGERATOR
  FREEZER
  SAFE
  RECEIVING
  QUARANTINE
  RETURN_TO_VENDOR
  WILL_CALL
  OTHER
}

enum InventoryStockState {
  AVAILABLE
  QUARANTINED
}

enum InventoryAllocationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  RETURNED
}

enum CoverageRelationship {
  SELF
  SPOUSE
  CHILD
  OTHER
}

enum ClaimStandard {
  D0
  F6
}

enum BillingNdcStrategy {
  MAJORITY_SOURCE
  REQUIRE_MANUAL_SELECTION
  SINGLE_SOURCE_ONLY
  PAYER_CONFIGURED
}

enum ClaimOperation {
  SUBMIT
  REVERSAL
}

enum ClaimOutcome {
  PAID
  REJECTED
  ERROR
  REVERSED
}

enum ExternalClaimOperationStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum ControlledSubstanceSchedule {
  NONE
  II
  III
  IV
  V
}

enum SerializedPackageStatus {
  RECEIVED
  AVAILABLE
  QUARANTINED
  DISPENSED
  TRANSFERRED
  RETURNED
  SUSPECT
  ILLEGITIMATE
}

enum PrescriptionLabelStatus {
  ACTIVE
  VOID
}

enum LabelPrintStatus {
  QUEUED
  PRINTED
  FAILED
  CANCELLED
}

enum PosTransactionStatus {
  COMPLETED
  VOIDED
}

enum PosPriceBasis {
  THIRD_PARTY
  CASH
  COMPLETION_ALREADY_BILLED
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  OTHER
}

enum PickupFulfillmentMode {
  WILL_CALL
  IMMEDIATE
}

enum PickupIdentityMethod {
  DATE_OF_BIRTH
  ADDRESS
  GOVERNMENT_ID
  KNOWN_PATIENT
  OTHER
}

enum PickupSignatureMethod {
  ELECTRONIC_TYPED
  EXTERNAL_DEVICE
  PAPER
}

enum WillCallPackageStatus {
  STAGED
  PICKED_UP
  RETURNED_TO_STOCK
}

enum WillCallBagBarcodeStatus {
  ACTIVE
  VOIDED
}

enum WillCallEventType {
  STAGED
  RELOCATED
  REBAGGED
  PICKED_UP
  RETURNED_TO_STOCK
}

enum ProductSelectionDirective {
  UNSPECIFIED
  SELECTION_PERMITTED
  DISPENSE_AS_WRITTEN
}

enum BiologicCommunicationStatus {
  OPEN
  COMPLETED
  EXEMPT
}

enum InventoryDemandStatus {
  OPEN
  READY
  FULFILLED
  CANCELLED
}

enum InventoryDemandSource {
  FILL
  COMPLETION
  REORDER
  MANUAL
}

enum InventoryPolicyScope {
  SITE
  PRODUCT
}

enum ReceivingDiscrepancyType {
  SHORT_SHIPMENT
  OVERAGE
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  LOT_EXPIRATION_MISMATCH
  INVOICE_MISMATCH
  DUPLICATE_SHIPMENT
  UNEXPECTED_PRODUCT
  OTHER
}

enum ReceivingDiscrepancyStatus {
  OPEN
  RESOLVED
}

enum InventoryExceptionType {
  BELOW_REORDER_POINT
  EXPIRING_SOON
  STALE_RESERVATION
  TRANSFER_STUCK
  PURCHASE_ORDER_OVERDUE
  UNALLOCATED_DEMAND
  POSITION_IMBALANCE
  MISSING_ACQUISITION_COST
  PHYSICAL_STOCK_SHORTAGE
}

enum InventoryExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum InventoryCustodyEventType {
  PACKED
  VERIFIED
  HANDED_OFF
  RECEIVED
  EXCEPTION
}

model PharmacySite {
  id            String         @id @default(uuid())
  name          String
  npi           String?
  ncpdpId       String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  siteRoleAssignments SiteRoleAssignment[]
  authSessions  AuthSession[]
  privilegedAccessRequests PrivilegedAccessRequest[]
  patients      Patient[]
  prescribers   Prescriber[]
  prescriptions Prescription[]
  productLots           ProductLot[]
  productExpirations    ProductExpiration[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  cycleCountSessions    CycleCountSession[]
  inventoryHolds        InventoryHold[]
  sourceInventoryTransfers      InventoryTransfer[] @relation("TransferSourceSite")
  destinationInventoryTransfers InventoryTransfer[] @relation("TransferDestinationSite")
  recallCases           RecallCase[]
  purchaseOrders        PurchaseOrder[]
  inventoryLocations    InventoryLocation[]
  inventoryAllocations  InventoryAllocation[]
  inventoryPolicies     InventoryPolicy[]
  inventoryDemands      InventoryDemand[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  inventoryExceptions   InventoryException[]
  custodyEvents         InventoryTransferCustodyEvent[]
  payers                Payer[]
  payerBillingProfiles  PayerBillingProfile[]
  patientCoverages      PatientCoverage[]
  biologicCommunicationTasks BiologicCommunicationTask[]
  claimTransactions     ClaimTransaction[]
  externalClaimOperations ExternalClaimOperation[]
  supplyChainTraceRecords SupplyChainTraceRecord[]
  serializedPackages SerializedPackage[]
  prescriptionLabels    PrescriptionLabel[]
  labelPrintJobs        LabelPrintJob[]
  posTransactions       PointOfSaleTransaction[]
  willCallPackages      WillCallPackage[]
  willCallBagBarcodes   WillCallBagBarcode[]
  willCallEvents        WillCallEvent[]
  documents             Document[]
  prescriptionAnnotations PrescriptionAnnotation[]
  prescriptionChangeRecords PrescriptionChangeRecord[]
  auditEvents           AuditEvent[]
}

model User {
  id                String             @id @default(uuid())
  siteId            String
  site              PharmacySite       @relation(fields: [siteId], references: [id])
  externalAuthId    String?            @unique
  oidcSubject       String?            @unique
  displayName       String
  role              UserRole
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  siteRoleAssignments SiteRoleAssignment[]
  authSessions      AuthSession[]
  privilegedAccessTargets PrivilegedAccessRequest[] @relation("PrivilegeTarget")
  privilegedAccessRequests PrivilegedAccessRequest[] @relation("PrivilegeRequester")
  privilegedAccessReviews PrivilegedAccessRequest[] @relation("PrivilegeReviewer")
  auditEvents       AuditEvent[]       @relation("ActorAuditEvents")
  resolvedDurIssues DurIssue[]         @relation("ResolvedDurIssues")
  interventionNotes     InterventionNote[]     @relation("InterventionAuthors")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionActors")
  createdCycleCounts     CycleCountSession[]     @relation("CycleCountCreatedBy")
  submittedCycleCounts   CycleCountSession[]     @relation("CycleCountSubmittedBy")
  reviewedCycleCounts    CycleCountSession[]     @relation("CycleCountReviewedBy")
  countedCycleCountLines CycleCountLine[]        @relation("CycleCountCountedBy")
  createdInventoryHolds  InventoryHold[]          @relation("InventoryHoldCreatedBy")
  resolvedInventoryHolds InventoryHold[]          @relation("InventoryHoldResolvedBy")
  initiatedTransfers     InventoryTransfer[]        @relation("TransferInitiatedBy")
  receivedTransfers      InventoryTransfer[]        @relation("TransferReceivedBy")
  cancelledTransfers     InventoryTransfer[]        @relation("TransferCancelledBy")
  createdRecallCases     RecallCase[]               @relation("RecallCreatedBy")
  closedRecallCases      RecallCase[]               @relation("RecallClosedBy")
  createdPurchaseOrders  PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  cancelledPurchaseOrders PurchaseOrder[]           @relation("PurchaseOrderCancelledBy")
  purchaseOrderReceipts  PurchaseOrderReceipt[]     @relation("PurchaseOrderReceiptActor")
  authorizedEmergencyFills PrescriptionFill[]         @relation("EmergencyFillAuthorizedBy")
  interruptedFills         PrescriptionFill[]         @relation("FillInterruptedBy")
  inventoryAllocations      InventoryAllocation[]
  createdReceivingDiscrepancies ReceivingDiscrepancy[] @relation("ReceivingDiscrepancyCreatedBy")
  resolvedReceivingDiscrepancies ReceivingDiscrepancy[] @relation("ReceivingDiscrepancyResolvedBy")
  acknowledgedInventoryExceptions InventoryException[] @relation("InventoryExceptionAcknowledgedBy")
  resolvedInventoryExceptions InventoryException[] @relation("InventoryExceptionResolvedBy")
  transferCustodyEvents InventoryTransferCustodyEvent[]
  documentedNtiConsents NtiManufacturerConsent[]
  completedBiologicCommunicationTasks BiologicCommunicationTask[] @relation("BiologicCommunicationCompletedBy")
  claimTransactions ClaimTransaction[] @relation("ClaimTransactionActor")
  labelPrintJobs LabelPrintJob[] @relation("LabelPrintJobActor")
  posTransactionsCreated PointOfSaleTransaction[] @relation("PosTransactionCreatedBy")
  posTransactionsVoided PointOfSaleTransaction[] @relation("PosTransactionVoidedBy")
  paymentTenders PaymentTender[] @relation("PaymentTenderActor")
  stagedWillCallPackages WillCallPackage[] @relation("WillCallPackageStagedBy")
  willCallEvents WillCallEvent[] @relation("WillCallEventActor")
  createdDocuments Document[] @relation("DocumentCreatedBy")
  prescriptionAnnotations PrescriptionAnnotation[] @relation("PrescriptionAnnotationCreatedBy")
  prescriptionChangeRecords PrescriptionChangeRecord[] @relation("PrescriptionChangeRecordChangedBy")
  reviewedPrescriptionChangeRecords PrescriptionChangeRecord[] @relation("PrescriptionChangeRecordReviewedBy")
  importedSupplyChainTraceRecords SupplyChainTraceRecord[] @relation("SupplyChainTraceImportedBy")

  @@index([siteId, role])
}

model Patient {
  id            String         @id @default(uuid())
  siteId        String
  site          PharmacySite   @relation(fields: [siteId], references: [id])
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  phone         String?
  phoneSearch   String?
  email         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
  coverages     PatientCoverage[]
  posTransactions PointOfSaleTransaction[]
  documents       Document[]

  @@index([siteId, lastName, firstName])
  @@index([siteId, dateOfBirth])
  @@index([siteId, phoneSearch])
}

model Prescriber {
  id                String                 @id @default(uuid())
  siteId            String
  site              PharmacySite           @relation(fields: [siteId], references: [id])
  firstName         String
  lastName          String
  practiceLevel     String
  dateOfBirth       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  prescriptions     Prescription[]
  identifiers       PrescriberIdentifier[]
  contacts          PrescriberContact[]
  addresses         PrescriberAddress[]

  @@index([siteId, lastName, firstName])
  @@index([siteId, dateOfBirth])
  @@index([siteId, practiceLevel])
}

model PrescriberIdentifier {
  id             String                   @id @default(uuid())
  siteId         String
  prescriberId   String
  prescriber     Prescriber               @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  type           PrescriberIdentifierType
  number         String
  numberSearch   String
  jurisdiction   String                   @default("")
  isPrimary      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([prescriberId, type, numberSearch, jurisdiction])
  @@index([siteId, type, numberSearch])
  @@index([prescriberId, type, isPrimary])
}

model PrescriberContact {
  id             String                 @id @default(uuid())
  prescriberId   String
  prescriber     Prescriber             @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  type           PrescriberContactType
  label          String?
  value          String
  valueSearch    String
  extension      String?
  isPrimary      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([prescriberId, type, isPrimary])
  @@index([type, valueSearch])
}

model PrescriberAddress {
  id             String     @id @default(uuid())
  prescriberId   String
  prescriber     Prescriber @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  label          String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  isPrimary      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([prescriberId, isPrimary])
  @@index([state, postalCode])
}

model Medication {
  id            String    @id @default(uuid())
  genericName   String
  brandName     String?
  strength      String
  dosageForm    String
  route         String?
  ncNarrowTherapeuticIndex Boolean @default(false)
  isBiological Boolean @default(false)
  hasFdaInterchangeableBiologicAlternative Boolean @default(false)
  controlledSubstanceSchedule ControlledSubstanceSchedule @default(NONE)
  requiresColdChain Boolean @default(false)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
  prescriptions Prescription[]
  inventoryDemands InventoryDemand[]

  @@index([genericName, strength, dosageForm])
  @@index([brandName])
}

model Manufacturer {
  id          String    @id @default(uuid())
  name        String    @unique
  labelerCode String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  fillSources FillProductSource[]
  ntiConsentsAsPrior NtiManufacturerConsent[] @relation("NtiPriorManufacturer")
  ntiConsentsAsNew   NtiManufacturerConsent[] @relation("NtiNewManufacturer")

  @@index([name])
}

model Product {
  id                 String       @id @default(uuid())
  medicationId       String
  medication         Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  manufacturerId     String
  manufacturer       Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  ndc                 String
  ndcSearch           String       @unique
  descriptor          String
  packageDescription  String?
  packageType         String?
  unitsPerPackage     Decimal?     @db.Decimal(12, 3)
  dispensingUnit      ProductUnit?
  unitPrice           Decimal?     @db.Decimal(12, 6)
  packagePrice        Decimal?     @db.Decimal(12, 4)
  therapeuticEquivalenceCode String?
  isInterchangeableBiological Boolean @default(false)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lots                ProductLot[]
  expirations         ProductExpiration[]
  prescriptionFills   PrescriptionFill[]
  prescribedOnPrescriptions Prescription[] @relation("PrescribedProduct")
  billedOnFills       PrescriptionFill[] @relation("BillingProduct")
  fillSources         FillProductSource[]
  barcodes             ProductBarcode[]
  inventoryBalances    InventoryBalance[]
  recallCases           RecallCase[]
  purchaseOrderLines    PurchaseOrderLine[]
  inventoryPolicies     InventoryPolicy[]
  inventoryDemands      InventoryDemand[]
  receivingDiscrepanciesExpected ReceivingDiscrepancy[] @relation("ReceivingDiscrepancyExpectedProduct")
  receivingDiscrepanciesObserved ReceivingDiscrepancy[] @relation("ReceivingDiscrepancyObservedProduct")
  serializedPackages     SerializedPackage[]

  @@index([medicationId, active])
  @@index([manufacturerId, active])
  @@index([ndc])
  @@index([descriptor])
}

model ProductBarcode {
  id               String             @id @default(uuid())
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             ProductBarcodeType
  identifier       String
  identifierSearch String
  isPrimary        Boolean            @default(false)
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([type, identifierSearch])
  @@index([productId, isPrimary])
  @@index([identifierSearch])
}

model ProductLot {
  id              String       @id @default(uuid())
  siteId          String
  site            PharmacySite @relation(fields: [siteId], references: [id])
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotNumber       String
  lotNumberSearch String
  active          Boolean      @default(true)
  receivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([siteId, productId, lotNumberSearch])
  @@index([productId, lotNumberSearch])
  prescriptionFills  PrescriptionFill[]
  inventoryBalances   InventoryBalance[]
  fillSources          FillProductSource[]

  @@index([siteId, active])
}

model ProductExpiration {
  id             String       @id @default(uuid())
  siteId         String
  site           PharmacySite @relation(fields: [siteId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  expirationDate DateTime
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([siteId, productId, expirationDate])
  @@index([siteId, expirationDate])
  prescriptionFills PrescriptionFill[]
  inventoryBalances  InventoryBalance[]
  fillSources        FillProductSource[]

  @@index([productId, expirationDate])
}

enum PrescriptionSourceType {
  MANUAL
  PAPER
  FAX
  ELECTRONIC
  VERBAL
  TRANSFER
}

enum DocumentSourceType {
  SCAN
  UPLOAD
  ELECTRONIC_RENDER
}

enum DocumentKind {
  PRESCRIPTION_SOURCE
  INSURANCE_CARD
  PRESCRIBER_COMMUNICATION
  PRIOR_AUTHORIZATION
  OTHER
}

enum PrescriptionAnnotationStatus {
  ACTIVE
  SUPERSEDED
}

enum PrescriptionChangeRecordStatus {
  ACTIVE
  SUPERSEDED
}

enum PrescriptionChangeType {
  SIG
  QUANTITY
  REFILLS
  DRUG
  STRENGTH
  DOSAGE_FORM
  DAW
  PRESCRIBER
  WRITTEN_DATE
  OTHER
}

enum PrescriptionChangeCommunicationMethod {
  PHONE
  FAX
  ELECTRONIC
  IN_PERSON
  OTHER
}

model Prescription {
  id                       String              @id @default(uuid())
  siteId                   String
  site                     PharmacySite        @relation(fields: [siteId], references: [id])
  patientId                String
  patient                  Patient             @relation(fields: [patientId], references: [id])
  prescriberId             String
  prescriber               Prescriber          @relation(fields: [prescriberId], references: [id])
  medicationId             String?
  medication               Medication?         @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  prescribedProductId       String?
  prescribedProduct         Product?            @relation("PrescribedProduct", fields: [prescribedProductId], references: [id], onDelete: Restrict)
  productSelectionDirective ProductSelectionDirective @default(UNSPECIFIED)
  rxNumber                 String?
  medicationName           String
  strength                 String?
  dosageForm               String?
  sig                      String
  quantityWritten          Decimal?            @db.Decimal(10, 3)
  refillsAllowed           Int                 @default(0)
  refillsUsed              Int                 @default(0)
  writtenDate              DateTime?
  expirationDate           DateTime?
  minimumDaysBetweenFills  Int?
  status                   PrescriptionStatus  @default(RECEIVED)
  sourceType               PrescriptionSourceType @default(MANUAL)
  electronicMessageId      String?
  electronicRawMessage     String?
  heldFromStatus           PrescriptionStatus?
  doNotFillBefore          DateTime?
  version                  Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  fills                    PrescriptionFill[]
  durIssues                DurIssue[]
  interventionNotes        InterventionNote[]
  documents                Document[]
  annotations              PrescriptionAnnotation[]
  changeRecords            PrescriptionChangeRecord[]

  @@unique([siteId, rxNumber])
  @@index([siteId, status])
  @@index([patientId])
  @@index([medicationId])
  @@index([prescribedProductId])
}

model PrescriptionFill {
  id                  String             @id @default(uuid())
  prescriptionId      String
  prescription        Prescription       @relation(fields: [prescriptionId], references: [id])
  fillNumber          Int
  partNumber          Int                @default(1)
  kind                FillKind           @default(STANDARD)
  scheduledFor        DateTime?
  daysSupply          Int?
  quantity                    Decimal?               @db.Decimal(10, 3)
  authorizedQuantity          Decimal?               @db.Decimal(10, 3)
  intendedQuantity            Decimal?               @db.Decimal(10, 3)
  payerIntendedQuantity       Decimal?               @db.Decimal(10, 3)
  physicalDispensedQuantity   Decimal                @default(0) @db.Decimal(10, 3)
  remainingOwedQuantity       Decimal                @default(0) @db.Decimal(10, 3)
  billingRole                 FillBillingRole        @default(PRIMARY_CLAIM)
  consumesRefill              Boolean                @default(true)
  completionOfFillId          String?
  completionOfFill            PrescriptionFill?      @relation("FillCompletionChain", fields: [completionOfFillId], references: [id], onDelete: Restrict)
  completionFills             PrescriptionFill[]     @relation("FillCompletionChain")
  billingAnchorFillId         String?
  billingAnchorFill           PrescriptionFill?      @relation("FillBillingAnchor", fields: [billingAnchorFillId], references: [id], onDelete: Restrict)
  billingCompletionFills      PrescriptionFill[]     @relation("FillBillingAnchor")
  interruptionReason          FillInterruptionReason?
  interruptionNote            String?
  interruptedAt               DateTime?
  interruptedById             String?
  interruptedBy               User?                  @relation("FillInterruptedBy", fields: [interruptedById], references: [id], onDelete: Restrict)
  emergencyReason     String?
  emergencyAuthorizedById String?
  emergencyAuthorizedBy User?            @relation("EmergencyFillAuthorizedBy", fields: [emergencyAuthorizedById], references: [id], onDelete: Restrict)
  emergencyAuthorizedAt DateTime?
  followUpDueAt       DateTime?
  followUpCompletedAt DateTime?
  followUpNote        String?
  status              FillStatus         @default(SCHEDULED)
  billingProductId    String?
  billingProduct      Product?            @relation("BillingProduct", fields: [billingProductId], references: [id], onDelete: Restrict)
  patientDiscardDate  DateTime?
  dispensedInOriginalContainer Boolean    @default(false)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productLotId        String?
  productLot          ProductLot?        @relation(fields: [productLotId], references: [id], onDelete: Restrict)
  productExpirationId String?
  productExpiration   ProductExpiration? @relation(fields: [productExpirationId], references: [id], onDelete: Restrict)
  scannedNdc          String?
  scannedLotNumber    String?
  scannedExpiration   DateTime?
  productVerifiedAt   DateTime?
  inventoryBalanceId  String?
  inventoryBalance    InventoryBalance? @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  inventoryReservedAt DateTime?
  inventoryCommittedAt DateTime?
  inventoryReturnedAt DateTime?
  inventoryTransactions InventoryTransaction[]
  recallAffectedFills RecallAffectedFill[]
  inventoryAllocations InventoryAllocation[]
  productSources      FillProductSource[]
  ntiManufacturerConsents NtiManufacturerConsent[]
  biologicCommunicationTask BiologicCommunicationTask?
  claimTransactions   ClaimTransaction[]
  prescriptionLabels  PrescriptionLabel[]
  posSaleLine          PointOfSaleLine?
  willCallPackage       WillCallPackage?
  inventoryDemand     InventoryDemand?
