  quantity           Decimal                  @db.Decimal(14, 3)
  reasonCode         InventoryHoldReason
  note               String?
  status             InventoryHoldStatus      @default(ACTIVE)
  createdById        String
  createdBy          User                     @relation("InventoryHoldCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedById       String?
  resolvedBy         User?                    @relation("InventoryHoldResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolutionNote     String?
  dispositionType    InventoryDispositionType?
  createdAt          DateTime                 @default(now())
  resolvedAt         DateTime?
  updatedAt          DateTime                 @updatedAt
  transactions       InventoryTransaction[]
  recallCaseId        String?
  recallCase          RecallCase?               @relation(fields: [recallCaseId], references: [id], onDelete: Restrict)

  @@index([siteId, status, createdAt])
  @@index([inventoryBalanceId, status])
  @@index([reasonCode, status])
  @@index([createdById, createdAt])
  @@index([resolvedById, resolvedAt])
  @@index([recallCaseId, status])
}

model InventoryTransaction {
  id                 String                   @id @default(uuid())
  siteId             String
  site               PharmacySite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  inventoryBalanceId String
  inventoryBalance   InventoryBalance         @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  fillId             String?
  fill               PrescriptionFill?        @relation(fields: [fillId], references: [id], onDelete: Restrict)
  actorId            String?
  actor              User?                    @relation("InventoryTransactionActors", fields: [actorId], references: [id], onDelete: Restrict)
  type               InventoryTransactionType
  onHandDelta        Decimal                  @default(0) @db.Decimal(14, 3)
  reservedDelta      Decimal                  @default(0) @db.Decimal(14, 3)
  quarantinedDelta   Decimal                  @default(0) @db.Decimal(14, 3)
  inventoryHoldId    String?
  inventoryHold      InventoryHold?           @relation(fields: [inventoryHoldId], references: [id], onDelete: Restrict)
  reason             String?
  source             String?
  reference          String?
  idempotencyKey     String?                  @unique
  idempotencyFingerprint String?
  unitCost           Decimal?                 @db.Decimal(12, 6)
  extendedCost       Decimal?                 @db.Decimal(14, 4)
  occurredAt         DateTime                 @default(now())
  cycleCountLine     CycleCountLine?          @relation("CycleCountReconciliation")
  inventoryTransferId String?
  inventoryTransfer   InventoryTransfer?       @relation(fields: [inventoryTransferId], references: [id], onDelete: Restrict)
  purchaseOrderReceipt PurchaseOrderReceipt?   @relation("PurchaseOrderReceiptTransaction")

  @@index([siteId, occurredAt])
  @@index([inventoryBalanceId, occurredAt])
  @@index([fillId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([inventoryHoldId, occurredAt])
  @@index([inventoryTransferId, occurredAt])
  @@index([idempotencyKey])
}

model InventoryTransfer {
  id                       String                  @id @default(uuid())
  sourceSiteId             String
  sourceSite               PharmacySite            @relation("TransferSourceSite", fields: [sourceSiteId], references: [id], onDelete: Restrict)
  destinationSiteId        String
  destinationSite          PharmacySite            @relation("TransferDestinationSite", fields: [destinationSiteId], references: [id], onDelete: Restrict)
  sourceInventoryBalanceId String
  sourceInventoryBalance   InventoryBalance        @relation("TransferSourceBalance", fields: [sourceInventoryBalanceId], references: [id], onDelete: Restrict)
  destinationInventoryBalanceId String?
  destinationInventoryBalance   InventoryBalance?   @relation("TransferDestinationBalance", fields: [destinationInventoryBalanceId], references: [id], onDelete: Restrict)
  productId                String
  lotNumber                String
  expirationDate           DateTime
  quantity                 Decimal                 @db.Decimal(14, 3)
  status                   InventoryTransferStatus @default(IN_TRANSIT)
  note                     String?
  initiatedById            String
  initiatedBy              User                    @relation("TransferInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  receivedById             String?
  receivedBy               User?                   @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledById            String?
  cancelledBy              User?                   @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  shippedAt                DateTime                 @default(now())
  receivedAt               DateTime?
  cancelledAt              DateTime?
  carrier                   String?
  trackingNumber            String?
  sealIdentifier            String?
  custodyReference          String?
  transactions             InventoryTransaction[]
  custodyEvents            InventoryTransferCustodyEvent[]

  @@index([sourceSiteId, status, shippedAt])
  @@index([destinationSiteId, status, shippedAt])
  @@index([sourceInventoryBalanceId, status])
}

model RecallCase {
  id               String       @id @default(uuid())
  siteId           String
  site             PharmacySite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotNumber        String?
  lotNumberSearch  String?
  reference        String
  reason           String
  status           RecallStatus @default(ACTIVE)
  createdById      String
  createdBy        User         @relation("RecallCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedById       String?
  closedBy         User?        @relation("RecallClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  closedAt         DateTime?
  closureNote      String?
  holds            InventoryHold[]
  affectedFills    RecallAffectedFill[]

  @@index([siteId, status, createdAt])
  @@index([siteId, productId, lotNumberSearch, status])
  @@index([reference])
}

model RecallAffectedFill {
  id           String           @id @default(uuid())
  recallCaseId String
  recallCase   RecallCase       @relation(fields: [recallCaseId], references: [id], onDelete: Cascade)
  fillId       String
  fill         PrescriptionFill @relation(fields: [fillId], references: [id], onDelete: Restrict)
  discoveredAt DateTime         @default(now())

  @@unique([recallCaseId, fillId])
  @@index([fillId])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  siteId        String
  site          PharmacySite        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orderNumber   String
  supplierName  String
  status        PurchaseOrderStatus @default(OPEN)
  note          String?
  createdById   String
  createdBy     User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledById String?
  cancelledBy   User?               @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())
  cancelledAt   DateTime?
  lines         PurchaseOrderLine[]
  discrepancies ReceivingDiscrepancy[]

  @@unique([siteId, orderNumber])
  @@index([siteId, status, createdAt])
  @@index([supplierName])
}

model PurchaseOrderLine {
  id                 String        @id @default(uuid())
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOrdered    Decimal       @db.Decimal(14, 3)
  quantityReceived   Decimal       @default(0) @db.Decimal(14, 3)
  unitCost           Decimal?      @db.Decimal(12, 6)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  receipts           PurchaseOrderReceipt[]
  discrepancies      ReceivingDiscrepancy[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseOrderReceipt {
  id                     String               @id @default(uuid())
  purchaseOrderLineId    String
  purchaseOrderLine      PurchaseOrderLine    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  actorId                String
  actor                  User                 @relation("PurchaseOrderReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  inventoryBalanceId     String
  inventoryBalance       InventoryBalance     @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  inventoryTransactionId String                @unique
  inventoryTransaction   InventoryTransaction @relation("PurchaseOrderReceiptTransaction", fields: [inventoryTransactionId], references: [id], onDelete: Restrict)
  quantity               Decimal              @db.Decimal(14, 3)
  lotNumber              String
  expirationDate         DateTime
  invoiceReference       String?
  unitCost               Decimal?             @db.Decimal(12, 6)
  extendedCost           Decimal?             @db.Decimal(14, 4)
  idempotencyKey         String?               @unique
  idempotencyFingerprint String?
  receivedAt             DateTime             @default(now())
  discrepancies          ReceivingDiscrepancy[]

  @@index([purchaseOrderLineId, receivedAt])
  @@index([inventoryBalanceId, receivedAt])
}

model InventoryLocation {
  id                   String                @id @default(uuid())
  siteId               String
  site                 PharmacySite          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  code                 String
  name                 String
  type                 InventoryLocationType
  active               Boolean               @default(true)
  isDefaultReceiving   Boolean               @default(false)
  isDefaultDispensing  Boolean               @default(false)
  isQuarantine         Boolean               @default(false)
  temperatureMinC      Decimal?              @db.Decimal(6, 2)
  temperatureMaxC      Decimal?              @db.Decimal(6, 2)
  barcode              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  stockPositions       InventoryStockPosition[]
  willCallPackages     WillCallPackage[]
  willCallEventsFrom    WillCallEvent[] @relation("WillCallEventFromLocation")
  willCallEventsTo      WillCallEvent[] @relation("WillCallEventToLocation")

  @@unique([siteId, code])
  @@unique([siteId, barcode])
  @@index([siteId, active, type])
}

model InventoryStockPosition {
  id                 String               @id @default(uuid())
  inventoryBalanceId String
  inventoryBalance   InventoryBalance     @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  locationId         String
  location           InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  state              InventoryStockState  @default(AVAILABLE)
  quantity           Decimal              @default(0) @db.Decimal(14, 3)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  allocations        InventoryAllocation[]

  @@unique([inventoryBalanceId, locationId, state])
  @@index([locationId, state])
  @@index([inventoryBalanceId, state])
}

model InventoryAllocation {
  id                 String                    @id @default(uuid())
  siteId             String
  site               PharmacySite              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  fillId             String
  fill               PrescriptionFill          @relation(fields: [fillId], references: [id], onDelete: Restrict)
  inventoryBalanceId String
  inventoryBalance   InventoryBalance          @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  fillProductSourceId String?
  fillProductSource   FillProductSource?         @relation(fields: [fillProductSourceId], references: [id], onDelete: SetNull)
  actorId            String?
  actor              User?                     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  inventoryStockPositionId String?
  inventoryStockPosition InventoryStockPosition? @relation(fields: [inventoryStockPositionId], references: [id], onDelete: Restrict)
  quantity           Decimal                   @db.Decimal(14, 3)
  status             InventoryAllocationStatus @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  resolvedAt         DateTime?

  @@index([siteId, status, createdAt])
  @@index([fillId, status])
  @@index([inventoryBalanceId, status])
  @@index([inventoryStockPositionId, status])
  @@index([fillProductSourceId, status])
}

model InventoryDemand {
  id                String                @id @default(uuid())
  siteId            String
  site              PharmacySite          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  medicationId      String
  medication        Medication            @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  productId         String?
  product           Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  fillId            String?               @unique
  fill              PrescriptionFill?     @relation(fields: [fillId], references: [id], onDelete: Restrict)
  source            InventoryDemandSource
  requiredQuantity  Decimal               @db.Decimal(14, 3)
  availableQuantity Decimal               @default(0) @db.Decimal(14, 3)
  status            InventoryDemandStatus @default(OPEN)
  neededBy          DateTime?
  note              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  fulfilledAt       DateTime?

  @@index([siteId, status, neededBy])
  @@index([medicationId, status])
  @@index([productId, status])
}

model InventoryPolicy {
  id                             String               @id @default(uuid())
  siteId                         String
  site                           PharmacySite         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  scope                          InventoryPolicyScope
  policyKey                      String
  productId                      String?
  product                        Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  reorderPoint                   Decimal?             @db.Decimal(14, 3)
  targetStockLevel               Decimal?             @db.Decimal(14, 3)
  minShelfLifeDays               Int                  @default(30)
  expirationWarningDays          Int                  @default(90)
  fefoEnabled                    Boolean              @default(true)
  staleReservationHours          Int                  @default(24)
  staleTransferHours             Int                  @default(48)
  purchaseOrderOverdueDays       Int                  @default(3)
  technicianAdjustmentThreshold  Decimal?             @db.Decimal(14, 3)
  preferredSupplierName          String?
  active                         Boolean              @default(true)
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  @@unique([siteId, policyKey])
  @@index([siteId, scope, active])
  @@index([productId, active])
}

model ReceivingDiscrepancy {
  id                String                     @id @default(uuid())
  siteId            String
  site              PharmacySite               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  purchaseOrderLineId String?
  purchaseOrderLine PurchaseOrderLine?         @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  receiptId         String?
  receipt           PurchaseOrderReceipt?      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  expectedProductId String?
  expectedProduct   Product?                   @relation("ReceivingDiscrepancyExpectedProduct", fields: [expectedProductId], references: [id], onDelete: Restrict)
  observedProductId String?
  observedProduct   Product?                   @relation("ReceivingDiscrepancyObservedProduct", fields: [observedProductId], references: [id], onDelete: Restrict)
  type              ReceivingDiscrepancyType
  expectedQuantity  Decimal?                   @db.Decimal(14, 3)
  observedQuantity  Decimal?                   @db.Decimal(14, 3)
  note              String?
  status            ReceivingDiscrepancyStatus @default(OPEN)
  createdById       String
  createdBy         User                       @relation("ReceivingDiscrepancyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedById      String?
  resolvedBy        User?                      @relation("ReceivingDiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolutionNote    String?
  createdAt         DateTime                   @default(now())
  resolvedAt        DateTime?

  @@index([siteId, status, createdAt])
  @@index([purchaseOrderId, status])
  @@index([purchaseOrderLineId, status])
}

model InventoryException {
  id                String                   @id @default(uuid())
  siteId            String
  site              PharmacySite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  fingerprint       String
  type              InventoryExceptionType
  status            InventoryExceptionStatus @default(OPEN)
  severity          DurSeverity              @default(WARNING)
  entityType        String
  entityId          String?
  title             String
  detail            String
  firstDetectedAt   DateTime                 @default(now())
  lastDetectedAt    DateTime                 @default(now())
  acknowledgedById String?
  acknowledgedBy   User?                    @relation("InventoryExceptionAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedBy       User?                    @relation("InventoryExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt       DateTime?
  resolutionNote   String?

  @@unique([siteId, fingerprint])
  @@index([siteId, status, severity, lastDetectedAt])
  @@index([type, status])
}

model InventoryTransferCustodyEvent {
  id             String                    @id @default(uuid())
  transferId     String
  transfer       InventoryTransfer         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  siteId         String
  site           PharmacySite              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  actorId        String
  actor          User                      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type           InventoryCustodyEventType
  carrier        String?
  trackingNumber String?
  sealIdentifier String?
  note           String?
  occurredAt     DateTime                  @default(now())

  @@index([transferId, occurredAt])
  @@index([siteId, occurredAt])
}

model DurIssue {
  id             String         @id @default(uuid())
  prescriptionId String
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])
  code           String
  title          String
  description           String?
  severity              DurSeverity    @default(WARNING)
  status                DurIssueStatus @default(OPEN)
  source                String         @default("SYNTHETIC_RULE")
  eligibleAt            DateTime?
  createdAt             DateTime       @default(now())
  resolvedAt            DateTime?
  resolutionNote        String?
  resolvedAutomatically Boolean        @default(false)
  resolvedById          String?
  resolvedBy            User?          @relation("ResolvedDurIssues", fields: [resolvedById], references: [id])

  @@index([prescriptionId, status])
  @@index([code, status])
}

model InterventionNote {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  authorId       String
  author         User         @relation("InterventionAuthors", fields: [authorId], references: [id])
  note           String
  createdAt      DateTime     @default(now())

  @@index([prescriptionId, createdAt])
}

model AuditEvent {
  id         String       @id @default(uuid())
  siteId     String
  site       PharmacySite @relation(fields: [siteId], references: [id])
  actorId    String?
  actor      User?        @relation("ActorAuditEvents", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  requestId  String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  @@index([siteId, occurredAt])
  @@index([entityType, entityId])
}


// Stage 3M: staff grants are scoped to a site; legacy User.role remains
// solely for the synthetic development workflow and historical records.
model SiteRoleAssignment {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  siteId    String
  site      PharmacySite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  role      UserRole
  active    Boolean      @default(true)
  grantedAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, siteId])
  @@index([siteId, active, role])
}

// A random session secret exists only in the browser's HttpOnly cookie.
// The database stores its SHA-256 hash, allowing immediate server revocation.
model AuthSession {
  id             String       @id @default(uuid())
  sessionHash    String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  siteId         String
  site           PharmacySite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  idleExpiresAt  DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  mfaVerifiedAt  DateTime

  @@index([userId, revokedAt])
  @@index([siteId, expiresAt])
}

// One-time authorization-code state; never a bearer-session credential.
model OidcLoginAttempt {
  stateHash   String   @id
  nonce       String
  pkceVerifier String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
}


// Stage 3M.3: scoped, audited two-person authorizations. Not a credential
// verification service. Never treat synthetic approvals as licensure evidence.
model PrivilegedAccessRequest {
  id                          String                 @id @default(uuid())
  siteId                      String
  site                        PharmacySite           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  targetUserId                String
  targetUser                  User                   @relation("PrivilegeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  requestedById               String
  requestedBy                 User                   @relation("PrivilegeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById                String?
  reviewedBy                  User?                  @relation("PrivilegeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  kind                        PrivilegedAccessKind
  status                      PrivilegedAccessStatus @default(PENDING)
  requestedRole               UserRole?
  requestedPermission         String?
  expectedAssignmentUpdatedAt DateTime?
  reason                      String
  reviewNote                  String?
  createdAt                   DateTime               @default(now())
  reviewDeadlineAt            DateTime
  reviewedAt                  DateTime?
  effectiveUntil              DateTime?

  @@index([siteId, status, createdAt])
  @@index([targetUserId, status, effectiveUntil])
}
