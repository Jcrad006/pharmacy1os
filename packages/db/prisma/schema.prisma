generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHARMACIST
  TECHNICIAN
  INTERN
  CASHIER
  AUDITOR
}

enum PrescriptionStatus {
  RECEIVED
  DATA_ENTRY
  DUR_REVIEW
  PRODUCT_FILL
  PHARMACIST_REVIEW
  READY
  SOLD
  ON_HOLD
  CANCELLED
  TRANSFERRED
}

enum FillStatus {
  SCHEDULED
  IN_PROGRESS
  READY
  SOLD
  RETURNED_TO_STOCK
  CANCELLED
}

enum DurSeverity {
  INFO
  WARNING
  HIGH
}

enum DurIssueStatus {
  OPEN
  RESOLVED
}

enum PrescriberIdentifierType {
  NPI
  DEA
  STATE_ID
}

enum PrescriberContactType {
  PHONE
  FAX
}

model PharmacySite {
  id            String         @id @default(uuid())
  name          String
  npi           String?
  ncpdpId       String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  patients      Patient[]
  prescribers   Prescriber[]
  prescriptions Prescription[]
  productLots        ProductLot[]
  productExpirations ProductExpiration[]
  auditEvents        AuditEvent[]
}

model User {
  id                String             @id @default(uuid())
  siteId            String
  site              PharmacySite       @relation(fields: [siteId], references: [id])
  externalAuthId    String?            @unique
  displayName       String
  role              UserRole
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditEvents       AuditEvent[]       @relation("ActorAuditEvents")
  resolvedDurIssues DurIssue[]         @relation("ResolvedDurIssues")
  interventionNotes InterventionNote[] @relation("InterventionAuthors")

  @@index([siteId, role])
}

model Patient {
  id            String         @id @default(uuid())
  siteId        String
  site          PharmacySite   @relation(fields: [siteId], references: [id])
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  phone         String?
  phoneSearch   String?
  email         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]

  @@index([siteId, lastName, firstName])
  @@index([siteId, dateOfBirth])
  @@index([siteId, phoneSearch])
}

model Prescriber {
  id                String                 @id @default(uuid())
  siteId            String
  site              PharmacySite           @relation(fields: [siteId], references: [id])
  firstName         String
  lastName          String
  practiceLevel     String
  dateOfBirth       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  prescriptions     Prescription[]
  identifiers       PrescriberIdentifier[]
  contacts          PrescriberContact[]
  addresses         PrescriberAddress[]

  @@index([siteId, lastName, firstName])
  @@index([siteId, dateOfBirth])
  @@index([siteId, practiceLevel])
}

model PrescriberIdentifier {
  id             String                   @id @default(uuid())
  siteId         String
  prescriberId   String
  prescriber     Prescriber               @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  type           PrescriberIdentifierType
  number         String
  numberSearch   String
  jurisdiction   String                   @default("")
  isPrimary      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([prescriberId, type, numberSearch, jurisdiction])
  @@index([siteId, type, numberSearch])
  @@index([prescriberId, type, isPrimary])
}

model PrescriberContact {
  id             String                 @id @default(uuid())
  prescriberId   String
  prescriber     Prescriber             @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  type           PrescriberContactType
  label          String?
  value          String
  valueSearch    String
  extension      String?
  isPrimary      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([prescriberId, type, isPrimary])
  @@index([type, valueSearch])
}

model PrescriberAddress {
  id             String     @id @default(uuid())
  prescriberId   String
  prescriber     Prescriber @relation(fields: [prescriberId], references: [id], onDelete: Cascade)
  label          String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  isPrimary      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([prescriberId, isPrimary])
  @@index([state, postalCode])
}

model Medication {
  id            String    @id @default(uuid())
  genericName   String
  brandName     String?
  strength      String
  dosageForm    String
  route         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@index([genericName, strength, dosageForm])
  @@index([brandName])
}

model Manufacturer {
  id          String    @id @default(uuid())
  name        String    @unique
  labelerCode String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
}

model Product {
  id                 String       @id @default(uuid())
  medicationId       String
  medication         Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  manufacturerId     String
  manufacturer       Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  ndc                 String
  ndcSearch           String       @unique
  labelName           String?
  packageDescription  String?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lots                ProductLot[]
  expirations         ProductExpiration[]

  @@index([medicationId, active])
  @@index([manufacturerId, active])
  @@index([ndc])
}

model ProductLot {
  id              String       @id @default(uuid())
  siteId          String
  site            PharmacySite @relation(fields: [siteId], references: [id])
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotNumber       String
  lotNumberSearch String
  active          Boolean      @default(true)
  receivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([siteId, productId, lotNumberSearch])
  @@index([productId, lotNumberSearch])
  @@index([siteId, active])
}

model ProductExpiration {
  id             String       @id @default(uuid())
  siteId         String
  site           PharmacySite @relation(fields: [siteId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  expirationDate DateTime
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([siteId, productId, expirationDate])
  @@index([siteId, expirationDate])
  @@index([productId, expirationDate])
}

model Prescription {
  id                       String              @id @default(uuid())
  siteId                   String
  site                     PharmacySite        @relation(fields: [siteId], references: [id])
  patientId                String
  patient                  Patient             @relation(fields: [patientId], references: [id])
  prescriberId             String
  prescriber               Prescriber          @relation(fields: [prescriberId], references: [id])
  rxNumber                 String?
  medicationName           String
  strength                 String?
  dosageForm               String?
  sig                      String
  quantityWritten          Decimal?            @db.Decimal(10, 3)
  refillsAllowed           Int                 @default(0)
  refillsUsed              Int                 @default(0)
  writtenDate              DateTime?
  expirationDate           DateTime?
  minimumDaysBetweenFills  Int?
  status                   PrescriptionStatus  @default(RECEIVED)
  heldFromStatus           PrescriptionStatus?
  doNotFillBefore          DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  fills                    PrescriptionFill[]
  durIssues                DurIssue[]
  interventionNotes        InterventionNote[]

  @@unique([siteId, rxNumber])
  @@index([siteId, status])
  @@index([patientId])
}

model PrescriptionFill {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  fillNumber     Int
  scheduledFor   DateTime?
  quantity       Decimal?     @db.Decimal(10, 3)
  status         FillStatus   @default(SCHEDULED)
  filledAt       DateTime?
  soldAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([prescriptionId, fillNumber])
  @@index([scheduledFor, status])
}

model DurIssue {
  id             String         @id @default(uuid())
  prescriptionId String
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])
  code           String
  title          String
  description           String?
  severity              DurSeverity    @default(WARNING)
  status                DurIssueStatus @default(OPEN)
  source                String         @default("SYNTHETIC_RULE")
  eligibleAt            DateTime?
  createdAt             DateTime       @default(now())
  resolvedAt            DateTime?
  resolutionNote        String?
  resolvedAutomatically Boolean        @default(false)
  resolvedById          String?
  resolvedBy            User?          @relation("ResolvedDurIssues", fields: [resolvedById], references: [id])

  @@index([prescriptionId, status])
  @@index([code, status])
}

model InterventionNote {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  authorId       String
  author         User         @relation("InterventionAuthors", fields: [authorId], references: [id])
  note           String
  createdAt      DateTime     @default(now())

  @@index([prescriptionId, createdAt])
}

model AuditEvent {
  id         String       @id @default(uuid())
  siteId     String
  site       PharmacySite @relation(fields: [siteId], references: [id])
  actorId    String?
  actor      User?        @relation("ActorAuditEvents", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  requestId  String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  @@index([siteId, occurredAt])
  @@index([entityType, entityId])
}
