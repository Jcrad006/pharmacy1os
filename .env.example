DATABASE_URL=postgresql://pharmacy1os:pharmacy1os_dev@localhost:5432/pharmacy1os?schema=public
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
ALLOW_DEV_IDENTITY=false
AUTH_MODE=development

# Local immutable prescription-document vault.
DOCUMENT_STORAGE_ROOT=./data/documents
# Development example only. Production must provide a unique 64-hex-character key
# through secret management rather than source control.
DOCUMENT_ENCRYPTION_KEY=

# Coordinated database + document-vault backups.
BACKUP_ROOT=./data/backups
# HMAC-SHA-256 manifest authenticity. Use at least 32 bytes of secret material.
BACKUP_SIGNING_KEY=
REQUIRE_SIGNED_BACKUPS=false

# Development-only synthetic claim adapter.
CLAIM_SANDBOX_ENABLED=true

# Stage 3M OIDC prototype, not a production deployment toggle.
# AUTH_MODE=oidc disables the x-dev-user impersonation path entirely.
# Configure a supported self-hosted OIDC provider (e.g. Keycloak), HTTPS,
# manually provision user.oidcSubject + site-role membership, and MFA.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://id.example.invalid/realms/pharmacy
# OIDC_CLIENT_ID=pharmacy1os
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://pharmacy.example.invalid/api/auth/callback
# OIDC_MFA_ACR_VALUES=
# AUTH_SESSION_SECRET=       # >=32 random bytes from secrets management

# Development/test ONLY; never enable for real staff or licensed pharmacy work.
ENABLE_SYNTHETIC_ROLE_GRANTS=false
