{
  "name": "pharmacy1os",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacy1OS — An Integrated Pharmacy Management and Information System",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pharmacy1os/api --filter @pharmacy1os/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @pharmacy1os/db generate",
    "db:validate": "pnpm --filter @pharmacy1os/db validate",
    "db:migrate": "pnpm --filter @pharmacy1os/db migrate",
    "db:deploy": "pnpm --filter @pharmacy1os/db migrate:deploy",
    "db:seed": "pnpm --filter @pharmacy1os/db seed",
    "db:studio": "pnpm --filter @pharmacy1os/db studio",
    "start": "SERVE_WEB=true pnpm --filter @pharmacy1os/api start",
    "backup:create": "pnpm --filter @pharmacy1os/api backup create",
    "backup:list": "pnpm --filter @pharmacy1os/api backup list",
    "backup:scan": "pnpm --filter @pharmacy1os/api backup scan",
    "backup:verify": "pnpm --filter @pharmacy1os/api backup verify",
    "backup:restore": "pnpm --filter @pharmacy1os/api backup restore"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
